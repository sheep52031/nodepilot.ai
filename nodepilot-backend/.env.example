# NodePilot Backend 環境變數範例

# OpenAI API Configuration (原有功能)
OPENAI_API_KEY=your_openai_api_key_here

# Voxtral 推理服務 (微服務架構)
# 遠端開發 (透過 Tailscale VPN 從其他裝置連接)
VOXTRAL_API_URL=http://YOUR_TAILSCALE_IP:8001
# 本機開發 (在推理服務本機開發時使用)
# VOXTRAL_API_URL=http://localhost:8001

# FastAPI 應用程式配置
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "chrome-extension://*"]

# 資料庫配置
DATABASE_URL=sqlite:///./nodepilot.db

# 舊版 API 設定 (已棄用，保留供參考)
# REPLICATE_API_TOKEN=your_replicate_api_token_here
# VOXTRAL_REMOTE_API_URL=https://your-ngrok-tunnel.ngrok.io
# AI_PROVIDER=openai