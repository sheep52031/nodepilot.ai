# OpenAI API Configuration (用於 Whisper 轉錄和 GPT 分析)
OPENAI_API_KEY=your_openai_api_key_here

# Replicate API Configuration (用於 Voxtral Mini 3B 本地推理)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# 遠端 RTX 3080 Voxtral API Configuration (優先使用)
VOXTRAL_REMOTE_API_URL=https://your-ngrok-tunnel.ngrok.io
VOXTRAL_REMOTE_API_TOKEN=your_anythingllm_api_token_here

# FastAPI Configuration
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./nodepilot.db

# CORS Configuration
ALLOWED_ORIGINS=["chrome-extension://*", "http://localhost:*"]

# AI Provider Configuration
AI_PROVIDER=openai